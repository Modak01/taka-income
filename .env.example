NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
# PostgreSQL connection string from your database provider; never commit a real password.
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/taka_income
# Use a unique random string of at least 32 characters in production.
SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
ADMIN_ID=TakaIncomeAdmin
# Admin account is not auto-created. Set these only after a secure provisioning process.
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
# Base64-encoded 32-byte AES key; generate with: openssl rand -base64 32
PAYOUT_ENCRYPTION_KEY=
# Set true only behind HTTPS in production.
COOKIE_SECURE=false
# Payment providers are NOT connected by default. Never put these secrets in frontend code.
BKASH_API_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_API_BASE_URL=
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
ROCKET_API_BASE_URL=
ROCKET_MERCHANT_ID=
ROCKET_API_SECRET=
# USDT transfers require a separately secured signer/provider. Do not store wallet seed phrases here.
USDT_PAYOUT_PROVIDER=
USDT_PAYOUT_API_KEY=
